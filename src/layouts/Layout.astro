---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Garrido Beauty - Catálogo Online" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-brand: 'Playfair Display', serif;
		--font-body: 'Lato', sans-serif;
		
		--color-black: #1a1a1a;
		--color-white: #ffffff;
		--color-gray-bg: #f9f9f9;
		--color-gray-text: #666;
		--color-accent: #e91e63;
		
		--container-width: 1200px;
	}

	* { box-sizing: border-box; margin: 0; padding: 0; }

	body {
		font-family: var(--font-body);
		background-color: var(--color-gray-bg);
		color: var(--color-black);
		line-height: 1.6;
	}

	h1, h2, h3, button { font-family: var(--font-brand); }
	img { max-width: 100%; display: block; }
</style>