---
const { product } = Astro.props;

const initial = product.name ? product.name.charAt(0).toUpperCase() : '?';

const getCategoryColor = (cat: string) => {
    const valorPuro = Array.isArray(cat) ? cat[0] : cat;
    const category = String(valorPuro || '').toLowerCase();
    if (category.includes('solar')) return '#F59E0B';
    if (category.includes('labios')) return '#E11D48';
    if (category.includes('rostro') || category.includes('facial')) return '#EC4899';
    if (category.includes('ojos')) return '#3B82F6';
    if (category.includes('cuerpo') || category.includes('body')) return '#10B981';
    if (category.includes('cabello') || category.includes('capilar')) return '#8B5CF6';
    if (category.includes('fragancia') || category.includes('perfume')) return '#6366F1';
    if (category.includes('uñas')) return '#F43F5E';
    return '#525252';
};

const bgColor = getCategoryColor(product.category);
---

<article class="product-card" data-category={product.category}>
    <div class="card-header">
        <span class="category-pill" style={`background-color: ${bgColor};`}>
            {product.category || 'General'}
        </span>
        {(product.oldPrice || product.isOffer) && <span class="badge-offer">OFERTA</span>}
    </div>

    <div class="img-container">
        <div class="thumb" style={`background-color: ${bgColor};`}>
            <span class="initial">{initial}</span>
            {product.image && (
                <img src={product.image} alt={product.name} onerror="this.style.display='none'" />
            )}
        </div>
    </div>

    <div class="card-body">
        <h3 class="product-title">{product.name}</h3>
        <p class="product-code">Cód: {product.id}</p>
        
        <p class="product-desc">
            {product.description ? product.description : (
                // Si no hay descripción en Airtable, usamos una genérica según la categoría
                product.category?.toLowerCase().includes('solar') ? 'Protección avanzada contra rayos UV para el cuidado de tu piel bajo el sol.' :
                product.category?.toLowerCase().includes('rostro') ? 'Fórmula especializada para hidratar y revitalizar la piel delicada del rostro.' :
                product.category?.toLowerCase().includes('labios') ? 'Color intenso y nutrición para unos labios suaves y definidos.' :
                product.category?.toLowerCase().includes('perfume') ? 'Fragancia exclusiva con notas persistentes y aroma envolvente.' :
                product.category?.toLowerCase().includes('cuerpo') ? 'Hidratación corporal profunda para una piel suave y elástica todo el día.' :
                product.category?.toLowerCase().includes('cabello') ? 'Tratamiento capilar para restaurar el brillo y la fuerza de tu pelo.' :
                'Producto de alta calidad seleccionado por Garrido Beauty para tu rutina de cuidado personal.'
            )}
        </p>
    </div>

    <div class="card-footer">
        <div class="price-box">
            {product.oldPrice && <span class="old-price">${Number(product.oldPrice).toLocaleString('es-AR')}</span>}
            <span class="price">${Number(product.price).toLocaleString('es-AR')}</span>
        </div>

        <div class="actions-row">
            <div class="qty-selector">
                <button class="qty-btn minus" type="button">-</button>
                <input type="text" value="1" readonly class="qty-input" />
                <button class="qty-btn plus" type="button">+</button>
            </div>
            
            <button 
                class="add-to-cart-btn"
                data-id={product.id}
                data-name={product.name}
                data-price={product.price}
                data-quantity="1" 
                aria-label="Agregar al carrito"
            >
                AGREGAR
            </button>
        </div>
    </div>
</article>

<script>
    import { addCartItem } from '../stores/cartStore';

    document.querySelectorAll('.product-card').forEach(card => {
        const minusBtn = card.querySelector('.minus');
        const plusBtn = card.querySelector('.plus');
        const input = card.querySelector('.qty-input');
        const addBtn = card.querySelector('.add-to-cart-btn');

        // Verificaciones de seguridad (TypeScript ya sabe que son elementos HTML si pasan esto)
        if (
            !minusBtn || !plusBtn || 
            !input || !(input instanceof HTMLInputElement) || 
            !addBtn || !(addBtn instanceof HTMLElement)
        ) return;

        // --- LÓGICA DE CANTIDAD ---
        plusBtn.addEventListener('click', () => {
            let val = parseInt(input.value || '0'); // Seguridad extra aquí también
            val++;
            input.value = val.toString();
            addBtn.dataset.quantity = val.toString();
        });

        minusBtn.addEventListener('click', () => {
            let val = parseInt(input.value || '0');
            if (val > 1) {
                val--;
                input.value = val.toString();
                addBtn.dataset.quantity = val.toString();
            }
        });

        // --- LÓGICA DE AGREGAR AL CARRITO ---
        addBtn.addEventListener('click', () => {
            // AQUÍ ESTABA EL ERROR:
            // Usamos || '' y || '0' para que TypeScript nunca vea un "undefined"
            const productData = {
                id: addBtn.dataset.id || 'unknown',
                name: addBtn.dataset.name || 'Sin nombre',
                price: parseFloat(addBtn.dataset.price || '0'), // ¡Arreglado!
                quantity: parseInt(addBtn.dataset.quantity || '1')
            };

            addCartItem(productData);

            // Feedback Visual
            const originalText = addBtn.innerText;
            addBtn.innerText = "¡LISTO!";
            addBtn.style.backgroundColor = "#10B981";
            
             setTimeout(() => {
                 input.value = "1";
                 addBtn.dataset.quantity = "1";
                 addBtn.innerText = originalText;
                 addBtn.style.backgroundColor = ""; 
             }, 1000);
        });
    });
</script>

<style>
    /* Estilo Tarjeta Vertical */
    .product-card {
        background: white;
        border: 1px solid #eee;
        border-radius: 12px; /* Bordes redondeados */
        padding: 1.2rem;
        display: flex;
        flex-direction: column; /* Elementos uno debajo del otro */
        transition: transform 0.2s, box-shadow 0.2s;
        height: 100%; /* Para que todas tengan la misma altura */
    }

    .product-card:hover {
        transform: translateY(-5px); /* Efecto de elevación al pasar el mouse */
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        border-color: #ddd;
    }

    /* Cabecera con etiquetas flotantes */
    .card-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .category-pill {
        color: white;
        font-size: 0.7rem;
        padding: 4px 8px;
        border-radius: 20px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-offer {
        background: var(--color-accent);
        color: white;
        font-size: 0.7rem;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    /* Imagen Grande */
    .img-container {
        display: flex;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .thumb {
        width: 80px; /* Círculo más grande */
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: white;
        font-family: var(--font-brand);
        font-size: 2rem;
        position: relative;
    }
    .thumb img { position: absolute; width: 100%; height: 100%; object-fit: cover; }

    /* Cuerpo */
    .card-body {
        flex-grow: 1; /* Empuja el footer hacia abajo */
        text-align: center;
        margin-bottom: 1rem;
    }

    .product-title {
        font-size: 1.1rem;
        margin-bottom: 0.3rem;
        color: var(--color-black);
    }

    .product-code {
        font-size: 0.75rem;
        color: #999;
        margin-bottom: 0.8rem;
    }

    .product-desc {
        font-size: 0.9rem;
        color: #666;
        line-height: 1.5;
        /* Limitamos a 3 líneas para que no quede gigante */
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Footer: Precio y Botones */
    .card-footer {
        border-top: 1px solid #f5f5f5;
        padding-top: 1rem;
    }

    .price-box {
        text-align: center;
        margin-bottom: 1rem;
    }

    .price { font-size: 1.4rem; font-weight: 700; color: var(--color-black); }
    .old-price { display: block; font-size: 0.9rem; text-decoration: line-through; color: #aaa; }

    .actions-row {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    /* Inputs y Botones adaptados a la tarjeta */
    .qty-selector { display: flex; border: 1px solid #ddd; border-radius: 6px; height: 40px; }
    .qty-btn { width: 30px; border: none; background: #f9f9f9; cursor: pointer; font-weight: bold; }
    .qty-input { width: 35px; border: none; text-align: center; outline: none; }

    .add-to-cart-btn {
        background: var(--color-black);
        color: white;
        border: none;
        border-radius: 6px;
        padding: 0 1.5rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
        height: 40px;
        flex-grow: 1; /* Ocupa el espacio restante */
    }
    .add-to-cart-btn:hover { background: var(--color-accent); transform: scale(1.02); }
</style>