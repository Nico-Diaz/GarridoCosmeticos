---
const { product } = Astro.props;

// Iniciales
const initial = product.name ? product.name.charAt(0).toUpperCase() : '?';

// Colores
const getCategoryColor = (cat: string) => {
    const valorPuro = Array.isArray(cat) ? cat[0] : cat;
    const category = String(valorPuro || '').toLowerCase();

    if (category.includes('solar')) return '#F59E0B';
    if (category.includes('labios')) return '#E11D48';
    if (category.includes('rostro') || category.includes('facial')) return '#EC4899';
    if (category.includes('ojos')) return '#3B82F6';
    if (category.includes('cuerpo') || category.includes('body')) return '#10B981';
    if (category.includes('cabello') || category.includes('capilar')) return '#8B5CF6';
    if (category.includes('fragancia') || category.includes('perfume')) return '#6366F1';
    if (category.includes('uñas')) return '#F43F5E';
    return '#525252';
};

const bgColor = getCategoryColor(product.category);
---

<article class="product-row" data-category={product.category}>
    <div class="thumb" style={`background-color: ${bgColor};`}>
        <span class="initial">{initial}</span>
        {product.image && (
            <img src={product.image} alt={product.name} onerror="this.style.display='none'" />
        )}
    </div>
    
    <div class="info clickable">
        <div class="header">
            <h3 class="truncate">{product.name}</h3>
            {(product.oldPrice || product.isOffer) && <span class="badge">OFERTA</span>}
        </div>
        <p class="code truncate">
            <span class="category-dot" style={`background-color: ${bgColor};`}></span>
            {product.category || 'General'} • Cód: {product.id}
        </p>
    </div>

    <div class="actions">
        <div class="prices">
            {product.oldPrice && <span class="old-price">${Number(product.oldPrice).toLocaleString('es-AR')}</span>}
            <span class="price">${Number(product.price).toLocaleString('es-AR')}</span>
        </div>
        
        <div class="qty-selector">
            <button class="qty-btn minus" type="button">-</button>
            <input type="text" value="1" readonly class="qty-input" />
            <button class="qty-btn plus" type="button">+</button>
        </div>

        <button 
            class="add-to-cart-btn"
            data-id={product.id}
            data-name={product.name}
            data-price={product.price}
            data-quantity="1" 
            aria-label="Agregar"
        >
            +
        </button>
    </div>
</article>

<script>
    document.querySelectorAll('.product-row').forEach(row => {
        // 1. Seleccionamos los elementos
        const minusBtn = row.querySelector('.minus');
        const plusBtn = row.querySelector('.plus');
        const input = row.querySelector('.qty-input');
        const addBtn = row.querySelector('.add-to-cart-btn');
        
        // Elementos para el acordeón (texto largo)
        const infoDiv = row.querySelector('.info');
        const title = row.querySelector('h3');
        const code = row.querySelector('.code');

        // 2. VERIFICACIÓN ESTRICTA (Esto arregla el error del dataset y value)
        if (
            !minusBtn || 
            !plusBtn || 
            !input || !(input instanceof HTMLInputElement) || 
            !addBtn || !(addBtn instanceof HTMLElement) 
        ) {
            return; // Si algo falla, paramos aquí para evitar errores
        }

        // --- LÓGICA DE TEXTO (Acordeón) ---
        if (infoDiv && title && code) {
            infoDiv.addEventListener('click', () => {
                title.classList.toggle('expanded');
                code.classList.toggle('expanded');
            });
        }

        // --- LÓGICA DE CANTIDAD ---
        plusBtn.addEventListener('click', () => {
            let val = parseInt(input.value);
            val++;
            input.value = val.toString();
            // Como ya verificamos que es HTMLElement, el editor permite usar dataset
            addBtn.dataset.quantity = val.toString();
        });

        minusBtn.addEventListener('click', () => {
            let val = parseInt(input.value);
            if (val > 1) {
                val--;
                input.value = val.toString();
                addBtn.dataset.quantity = val.toString();
            }
        });
        
        // Resetear botón después de agregar
        addBtn.addEventListener('click', () => {
             setTimeout(() => {
                 input.value = "1";
                 addBtn.dataset.quantity = "1";
             }, 100);
        });
    });
</script>

<style>
    .product-row {
        display: flex;
        align-items: center; /* Centrado vertical */
        background: white;
        padding: 0.8rem 0.5rem;
        border-bottom: 1px solid #f0f0f0;
        gap: 0.8rem;
        flex-wrap: nowrap;
        align-items: flex-start; /* Alineamos arriba para que si crece el texto, el icono quede arriba */
    }

    .thumb {
        width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; position: relative;
        display: flex; align-items: center; justify-content: center; overflow: hidden;
        color: white; font-family: var(--font-brand); font-weight: bold; font-size: 1.2rem;
        margin-top: 2px; /* Pequeño ajuste para alinear con la primera línea de texto */
    }
    .thumb img { position: absolute; width: 100%; height: 100%; object-fit: cover; background: white; }
    
    .info {
        flex-grow: 1;
        min-width: 0;
        overflow: hidden;
        cursor: pointer; /* Manito para indicar click */
        user-select: none; /* Evita que se seleccione el texto al hacer click rápido */
    }

    /* ESTILO PARA CUANDO SE TOCA (Efecto visual opcional) */
    .info:active { opacity: 0.7; }

    .header { 
        display: flex; 
        align-items: flex-start; /* Para que el badge no se estire */
        gap: 5px;
        flex-wrap: wrap; /* Permitimos wrap si se expande */
    }

    h3 {
        font-size: 0.95rem;
        margin: 0;
        color: var(--color-black);
        font-weight: 600;
        font-family: var(--font-body);
        line-height: 1.3;
    }

    /* --- CLASES DE TRUNCADO Y EXPANSIÓN --- */
    .truncate {
        white-space: nowrap;      /* Obliga a una línea */
        overflow: hidden;         /* Oculta lo que sobra */
        text-overflow: ellipsis;  /* Pone los ... */
        transition: all 0.2s ease; /* Animación suave no necesaria pero queda bien si hay cambios de color */
    }

    /* Cuando tiene esta clase, se muestra todo */
    .truncate.expanded {
        white-space: normal;      /* Permite múltiples líneas */
        overflow: visible;        /* Muestra todo */
    }

    .code {
        font-size: 0.7rem;
        color: #888;
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 2px;
    }

    .category-dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .badge { background-color: var(--color-accent); color: white; font-size: 0.55rem; padding: 1px 4px; border-radius: 4px; font-weight: bold; flex-shrink: 0; margin-top: 2px; }

    .actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-left: auto;
        flex-shrink: 0;
        padding-top: 2px; /* Alineación visual con el texto */
    }

    .prices { display: flex; flex-direction: column; align-items: flex-end; margin-right: 2px; }
    .price { font-weight: 700; color: var(--color-black); font-size: 1rem; }
    .old-price { font-size: 0.7rem; text-decoration: line-through; color: #aaa; }

    .qty-selector { display: flex; align-items: center; border: 1px solid #ddd; border-radius: 4px; overflow: hidden; height: 32px; }
    .qty-btn { background: #f9f9f9; border: none; width: 28px; height: 100%; font-weight: bold; cursor: pointer; color: var(--color-black); padding: 0; display: flex; align-items: center; justify-content: center;}
    .qty-input { width: 28px; height: 100%; border: none; text-align: center; font-size: 0.85rem; color: var(--color-black); outline: none; padding: 0; }

    .add-to-cart-btn {
        background: var(--color-black); color: white; border: none; width: 32px; height: 32px;
        border-radius: 4px; font-size: 1.2rem; font-weight: bold; cursor: pointer; transition: background 0.2s;
        display: flex; align-items: center; justify-content: center; padding: 0; padding-bottom: 2px;
    }
    .add-to-cart-btn:hover { background: var(--color-accent); }

    @media (max-width: 380px) {
        .product-row { gap: 0.4rem; padding: 0.8rem 0.2rem; }
        .thumb { width: 36px; height: 36px; font-size: 1rem; }
        h3 { font-size: 0.85rem; }
        .price { font-size: 0.9rem; }
        .qty-selector, .add-to-cart-btn { height: 30px; }
        .qty-btn, .qty-input, .add-to-cart-btn { width: 26px; }
    }
</style>