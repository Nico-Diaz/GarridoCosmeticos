---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Cart from '../components/Cart.jsx';
import { getProducts } from '../services/airtable'; 

// ACTUALIZACIÓN: Agregamos 'codigo' a la interfaz
interface Product {
    id: string;
    codigo?: string | number; // <--- NUEVO CAMPO
    name: string;
    category: string;
    description?: string;
    price: number;
    oldPrice?: number;
    isOffer?: boolean;
    image?: string;
    airtableId?: string;
}

const products: Product[] = await getProducts();

const categories = [
    'Todos', 'Solar', 'Rostro', 'Cuerpo', 'Cabello', 
    'Labios', 'Maquillaje', 'Fragancias', 'Uñas', 'General'
];
---

<Layout title="Garrido Beauty - Catálogo">
    <main>
        <header class="hero">
            <h1>Garrido <span class="text-gradient">Beauty</span></h1>
            <p class="subtitle">TU BELLEZA, NUESTRA FIRMA</p>
        </header>

        <section class="filters-container">
            <div class="filters-scroll">
                {categories.map(cat => (
                    <button class={`filter-btn ${cat === 'Todos' ? 'active' : ''}`} data-category={cat}>
                        {cat}
                    </button>
                ))}
            </div>
        </section>

        <section class="product-list-container">
            {products.map(product => (
                <ProductCard product={product} />
            ))}
            
            <div id="no-results" style="display: none; text-align: center; width: 100%; grid-column: 1 / -1; padding: 2rem;">
                <p style="color: #666;">No hay productos en esta categoría por el momento.</p>
            </div>
        </section>

        <div class="cart-wrapper">
            <Cart client:only="react" />
        </div>
    </main>
</Layout>

<script>
    // Tu lógica de filtrado se mantiene igual, funciona perfecta.
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.product-card'); 
        const noResultsMsg = document.getElementById('no-results');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                buttons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const selectedCategory = (btn as HTMLElement).dataset.category || btn.textContent?.trim() || 'Todos';
                let visibleCount = 0;

                cards.forEach(card => {
                    const cardElement = card as HTMLElement;
                    const productCategory = (cardElement.dataset.category || '').trim();

                    if (selectedCategory === 'Todos' || productCategory === selectedCategory) {
                        cardElement.style.display = 'flex'; 
                        visibleCount++;
                    } else {
                        cardElement.style.display = 'none';
                    }
                });

                if (noResultsMsg) {
                    noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            });
        });
    });
</script>

<style>
    /* Tus estilos se mantienen igual */
    main { max-width: 100%; margin: 0 auto; padding-bottom: 80px; }
    .hero { text-align: center; padding: 2rem 1rem; background: #fff; margin-bottom: 1rem; }
    h1 { font-size: 2.5rem; font-weight: 800; margin: 0; font-family: var(--font-brand); letter-spacing: -1px; }
    .text-gradient { color: var(--color-accent); }
    .subtitle { color: #888; letter-spacing: 2px; font-size: 0.8rem; margin-top: 0.5rem; font-weight: 500; }
    .filters-container { position: sticky; top: 0; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(5px); z-index: 10; padding: 10px 0; border-bottom: 1px solid #eee; margin-bottom: 20px; }
    .filters-scroll { display: flex; gap: 10px; overflow-x: auto; padding: 0 20px; padding-bottom: 5px; -webkit-overflow-scrolling: touch; scrollbar-width: none; justify-content: center; }
    @media (max-width: 850px) { .filters-scroll { justify-content: flex-start; } }
    .filters-scroll::-webkit-scrollbar { display: none; }
    .filter-btn { background: white; border: 1px solid #e5e5e5; padding: 6px 16px; border-radius: 20px; font-size: 0.9rem; color: #555; white-space: nowrap; cursor: pointer; transition: all 0.2s; font-family: var(--font-body); }
    .filter-btn:hover { border-color: #333; color: #000; }
    .filter-btn.active { background: var(--color-black); color: white; border-color: var(--color-black); }
    .product-list-container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; padding: 0 20px; }
    @media (max-width: 600px) { .product-list-container { grid-template-columns: 1fr; padding: 0 15px; } }
    .cart-wrapper { position: fixed; bottom: 20px; right: 20px; z-index: 100; width: auto; }
</style>